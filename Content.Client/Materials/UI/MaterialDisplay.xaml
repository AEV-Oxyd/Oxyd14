<PanelContainer xmlns="https://spacestation14.io"
                xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                MinSize="80 80"
                SetSize="80 80"
                StyleClasses="PanelDeep"
                Margin="1">
    <TextureRect Name="Icon"
                 Access="Public"
                 Stretch="KeepAspectCentered"
                 TextureScale="2.5 2.5"
                 MouseFilter="Ignore" />

    <PanelContainer Name="CountBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2 2 0 0" MouseFilter="Ignore">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#00000099" />
        </PanelContainer.PanelOverride>
        <Label Name="CountOverlay"
               Access="Public"
               Text="0"
               Margin="3 1"
               StyleClasses="LabelKeyText"
               FontColorOverride="#FFFFFF"/>
    </PanelContainer>
</PanelContainer>
