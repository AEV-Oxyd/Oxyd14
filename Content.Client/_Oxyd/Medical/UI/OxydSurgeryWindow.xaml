<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'oxyd-surgery-window-title'}"
               MinSize="720 480"
               SetSize="840 580">
    <!-- Eris meat-mode body: flat #7e050c under the tiled blood-splatter texture,
         matching nano/images/uiBackground-Meat.png over body background-color. -->
    <PanelContainer Name="MeatRoot" VerticalExpand="True" HorizontalExpand="True">
        <PanelContainer Name="MeatTexture" MouseFilter="Ignore" VerticalExpand="True" HorizontalExpand="True"/>
        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6"
                      VerticalExpand="True" HorizontalExpand="True">
            <Label Name="PatientLabel" HorizontalExpand="True"/>
            <Label Name="ToolLabel" HorizontalExpand="True"/>
            <!-- Populated in code: external view (organ cards + diagnostics) or
                 internal view (wounds + diagnostics + modifications). -->
            <BoxContainer Name="ContentRoot" Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True"/>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
