<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'oxyd-scanner-window-title'}"
               MinSize="480 440"
               SetSize="520 560">
    <!-- Eris health-scan browse window recreated on the NanoUI dark skin. -->
    <PanelContainer Name="Body" VerticalExpand="True" HorizontalExpand="True">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Name="Content" Orientation="Vertical" Margin="8" SeparationOverride="4"
                          HorizontalExpand="True"/>
        </ScrollContainer>
    </PanelContainer>
</controls:FancyWindow>
