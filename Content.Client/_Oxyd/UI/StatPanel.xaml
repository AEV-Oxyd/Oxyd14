<ui1:StatPanel xmlns="https://spacestation14.io"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui1="clr-namespace:Content.Client._Oxyd.UI"
           xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
           VerticalExpand="False"
           Orientation="Vertical"
           VerticalAlignment="Top"
           SeparationOverride="2"
>
    <BoxContainer Orientation="Horizontal" Name="StatMenus" Access="Public" VerticalExpand="True" HorizontalExpand="True" SizeFlagsStretchRatio="1" Margin="2 0 2 2"/>
    <PanelContainer Name="SeparatedChatPanel" StyleClasses="ErisStyleDigital" VerticalExpand="True" HorizontalExpand="True" SizeFlagsStretchRatio="16">
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="StatContent" Access="Public" Margin="6 4 6 4" Orientation="Vertical" HorizontalExpand="True"/>
        </ScrollContainer>
    </PanelContainer>
</ui1:StatPanel>
