<cartridges:DownloaderUiFragment xmlns:cartridges="clr-namespace:Content.Client._Oxyd.Computers.Cartridges"
                                 xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                                 xmlns="https://spacestation14.io" Margin="1 0 2 0">
    <PanelContainer StyleClasses="BackgroundDark"/>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="6">
        <!-- Server Connection Status -->
        <PanelContainer StyleClasses="ErisStyleDigital" Margin="0 0 0 4">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4">
                <BoxContainer Orientation="Vertical">
                    <Label Name="ServerHeaderLabel" Text="SERVER: Central Repository [MAIN-01]" StyleClasses="LabelSubText" FontColorOverride="#00D4FF"/>
                    <Label Name="LinkSpeedLabel" Text="LINK: 250 KB/s | STATUS: ONLINE" StyleClasses="LabelSubText" FontColorOverride="#00FF88"/>
                </BoxContainer>
                <Control HorizontalExpand="True"/>
                <controls:ContentStandardButton Name="RefreshButton" Text="Refresh" StyleClasses="ErisHoloButton" SetWidth="70" VerticalAlignment="Center"/>
            </BoxContainer>
        </PanelContainer>

        <!-- Category Filter Buttons -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 4">
            <controls:ContentStandardButton Name="CatAllButton" Text="All" StyleClasses="ErisHoloButton" HorizontalExpand="True"/>
            <controls:ContentStandardButton Name="CatProgramsButton" Text="Programs" StyleClasses="ErisHoloButton" HorizontalExpand="True" Margin="2 0"/>
            <controls:ContentStandardButton Name="CatDatabasesButton" Text="Databases" StyleClasses="ErisHoloButton" HorizontalExpand="True"/>
            <controls:ContentStandardButton Name="CatBlueprintsButton" Text="Blueprints" StyleClasses="ErisHoloButton" HorizontalExpand="True" Margin="2 0"/>
            <controls:ContentStandardButton Name="CatDocsButton" Text="Docs" StyleClasses="ErisHoloButton" HorizontalExpand="True"/>
        </BoxContainer>

        <!-- Repository Catalog List -->
        <PanelContainer StyleClasses="ErisStyleDigital" VerticalExpand="True" HorizontalExpand="True" Margin="0 0 0 4">
            <controls:ContentScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Orientation="Vertical" Name="CatalogContainer" HorizontalExpand="True" VerticalExpand="True" Margin="4"/>
            </controls:ContentScrollContainer>
        </PanelContainer>

        <!-- Status Footer -->
        <PanelContainer Name="StatusPanel" StyleClasses="ErisStyleDigital" Visible="False">
            <Label Name="StatusMessageLabel" Text="" StyleClasses="LabelSubText" FontColorOverride="#E0F7FA" Margin="6 3"/>
        </PanelContainer>
    </BoxContainer>
</cartridges:DownloaderUiFragment>
