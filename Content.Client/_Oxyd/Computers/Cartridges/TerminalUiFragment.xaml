<cartridges:TerminalUiFragment xmlns:cartridges="clr-namespace:Content.Client._Oxyd.Computers.Cartridges"
                                  xmlns="https://spacestation14.io" Margin="1 0 2 0">
    <PanelContainer StyleClasses="BackgroundDark"/>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="6">
        <!-- Status Bar -->
        <PanelContainer StyleClasses="ErisStyleDigital" Margin="0 0 0 4">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4">
                <Label Name="ConnectionStatusLabel" Text="MODE: LOCAL SHELL" StyleClasses="LabelSubText" FontColorOverride="#00D4FF"/>
                <Control HorizontalExpand="True"/>
                <CheckBox Name="AutoScrollCheckBox" Text="Auto-Scroll" Margin="4 0" Pressed="True"/>
                <Button Name="KeygenButton" Text="Keygen" StyleClasses="ErisHoloButton" SetWidth="70" Margin="2 0"/>
                <Button Name="ClearButton" Text="Clear" StyleClasses="ErisHoloButton" SetWidth="60" Margin="2 0"/>
                <Button Name="ExitSshButton" Text="Exit SSH" StyleClasses="ErisHoloButton" SetWidth="70" Visible="False" Margin="2 0 0 0"/>
            </BoxContainer>
        </PanelContainer>

        <!-- Terminal Output View -->
        <PanelContainer StyleClasses="ErisStyleDigital" VerticalExpand="True" HorizontalExpand="True" Margin="0 0 0 4">
            <OutputPanel Name="TerminalOutput" HorizontalExpand="True" VerticalExpand="True" Margin="6" ShowScrollDownButton="True"/>
        </PanelContainer>

        <!-- Command Input Line -->
        <PanelContainer StyleClasses="ErisStyleDigital">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4">
                <Label Name="PromptLabel" Text="[$] " StyleClasses="LabelHeading" FontColorOverride="#00FF88" Margin="0 0 4 0"/>
                <LineEdit Name="CommandLineInput" HorizontalExpand="True" PlaceHolder="Enter command (e.g. 'help', 'ssh [guid]', 'ls', 'ping [guid]')"/>
                <Button Name="SendButton" Text="Run" SetWidth="50" StyleClasses="ErisHoloButton" Margin="4 0 0 0"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</cartridges:TerminalUiFragment>
