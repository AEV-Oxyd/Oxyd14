<cartridges:FileBrowserUiFragment xmlns:cartridges="clr-namespace:Content.Client._Oxyd.Computers.Cartridges"
                                       xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                                       xmlns="https://spacestation14.io" Margin="1 0 2 0">
    <PanelContainer StyleClasses="BackgroundDark"/>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="6">

        <!-- Browser Directory & File List Mode (Full Height) -->
        <BoxContainer Name="BrowserViewContainer" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <!-- Directory Path & Navigation -->
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 6">
                <Label Text="Path: " StyleClasses="LabelHeading"/>
                <Label Name="CurrentPathLabel" Text="/" StyleClasses="LabelHeading" FontColorOverride="#00D4FF"/>
                <Control HorizontalExpand="True"/>
                <controls:ContentStandardButton Name="RootDirButton" Text="/" SetWidth="28" StyleClasses="ErisHoloButton"/>
                <controls:ContentStandardButton Name="BinDirButton" Text="/bin/" StyleClasses="ErisHoloButton" Margin="2 0 0 0"/>
                <controls:ContentStandardButton Name="NotesDirButton" Text="/notes/" StyleClasses="ErisHoloButton" Margin="2 0 0 0"/>
                <controls:ContentStandardButton Name="RecordsDirButton" Text="/records/" StyleClasses="ErisHoloButton" Margin="2 0 0 0"/>
                <controls:ContentStandardButton Name="SysDirButton" Text="/sys/" StyleClasses="ErisHoloButton" Margin="2 0 0 0"/>
                <controls:ContentStandardButton Name="BlueprintsDirButton" Text="/blueprints/" StyleClasses="ErisHoloButton" Margin="2 0 0 0"/>
                <controls:ContentStandardButton Name="DiskDirButton" Text="/disk/" StyleClasses="ErisHoloButton" Margin="3 0 0 0"/>
                <controls:ContentStandardButton Name="NewFileButton" Text="+ New" StyleClasses="ErisHoloButton" Margin="3 0 0 0" SetWidth="46"/>
            </BoxContainer>

            <!-- Mounted Disk Status Banner -->
            <PanelContainer Name="DiskBanner" StyleClasses="ErisStyleDigital" Margin="0 0 0 4" Visible="False">
                <BoxContainer Orientation="Horizontal" Margin="6 2" HorizontalExpand="True" VerticalAlignment="Center">
                    <Label Text="DISK: " StyleClasses="LabelHeading" FontColorOverride="#00D4FF"/>
                    <Label Name="DiskNameLabel" Text="Data Disk" StyleClasses="LabelSubText" FontColorOverride="#FFFFFF"/>
                    <Control HorizontalExpand="True"/>
                    <Label Name="DiskUsageLabel" Text="0 / 128 KB" StyleClasses="LabelSubText" FontColorOverride="#88AAAA" Margin="0 0 8 0"/>
                    <controls:ContentStandardButton Name="DiskEjectButton" Text="Eject" StyleClasses="ErisHoloButton" SetWidth="60"/>
                </BoxContainer>
            </PanelContainer>

            <!-- File List View (Takes entire remaining space) -->
            <PanelContainer StyleClasses="ErisStyleDigital" VerticalExpand="True" HorizontalExpand="True">
                <controls:ContentScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical" Name="FileListContainer" HorizontalExpand="True" VerticalExpand="True" Margin="4"/>
                </controls:ContentScrollContainer>
            </PanelContainer>

            <!-- Status Message Footer -->
            <Label Name="StatusMessageLabel" Visible="False" Text="" StyleClasses="LabelSubText" FontColorOverride="#AAAAAA" Margin="2 4 0 0"/>
        </BoxContainer>

        <!-- Full-Screen File Viewer Mode (Takes Entire Fragment Space) -->
        <BoxContainer Name="FilePreviewContainer" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Visible="False">
            <!-- File Viewer Header Bar -->
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 6">
                <Label Text="FILE: " StyleClasses="LabelHeading" FontColorOverride="#558899"/>
                <Label Name="PreviewFileNameLabel" Text="File Preview" StyleClasses="LabelHeading" FontColorOverride="#00D4FF"/>
                <Control HorizontalExpand="True"/>
                <controls:ContentStandardButton Name="PreviewEditButton" Text="Open in Notekeeper" StyleClasses="ErisHoloButton" Margin="0 0 6 0" Visible="False" SetWidth="140"/>
                <controls:ContentStandardButton Name="PreviewTransferButton" Text="Copy to Disk" StyleClasses="ErisHoloButton" Margin="0 0 6 0" Visible="False" SetWidth="110"/>
                <controls:ContentStandardButton Name="ClosePreviewButton" Text="&lt; Back to Files" StyleClasses="ErisHoloButton" SetWidth="120"/>
            </BoxContainer>

            <!-- Full-Screen Document Content -->
            <PanelContainer StyleClasses="ErisStyleDigital" VerticalExpand="True" HorizontalExpand="True">
                <controls:ContentScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="10 8">
                        <RichTextLabel Name="PreviewContentLabel" HorizontalExpand="True"/>
                    </BoxContainer>
                </controls:ContentScrollContainer>
            </PanelContainer>
        </BoxContainer>

    </BoxContainer>
</cartridges:FileBrowserUiFragment>
