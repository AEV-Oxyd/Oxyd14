<Control xmlns="https://spacestation14.io">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 1">
        <Button
            Name="Button"
            HorizontalExpand="True"
            Margin="0"
            StyleClasses="ButtonSquare OpenRight">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <BoxContainer
                    Name="RecipeDisplayContainer"
                    Margin="0 0 4 0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinSize="32 32"
                    />
                <Label Name="RecipeName" HorizontalExpand="True" ClipText="True" VerticalAlignment="Center" />
                <BoxContainer
                    Name="MaterialsContainer"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="6 0 6 0"
                    SeparationOverride="4"
                    />
                <Label
                    Name="DRMCost"
                    Align="Right"
                    VerticalAlignment="Center"
                    Margin="4 0 4 0"
                    FontColorOverride="#FFD700"
                    StyleClasses="LabelSubText"
                    />
            </BoxContainer>
        </Button>
        <Button
            Name="Button3x"
            Text="3x"
            MinWidth="34"
            Margin="0"
            StyleClasses="OpenBoth"
            ToolTip="Queue 3 items"
            />
        <Button
            Name="Button5x"
            Text="5x"
            MinWidth="34"
            Margin="0"
            StyleClasses="OpenLeft"
            ToolTip="Queue 5 items"
            />
    </BoxContainer>
</Control>
