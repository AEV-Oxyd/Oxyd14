<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'lathe-menu-title'}"
    MinSize="850 480"
    SetSize="980 560">
    <BoxContainer
        Orientation="Horizontal"
        VerticalExpand="True"
        HorizontalExpand="True"
        SeparationOverride="8">
        <!-- Col 1: Recipes Browser -->
        <BoxContainer
            Orientation="Vertical"
            VerticalExpand="True"
            HorizontalExpand="True"
            SizeFlagsStretchRatio="5"
            MinWidth="340"
            SeparationOverride="5">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Name="DiskName" Text="No Disk Loaded" MinWidth="100"/>
                <Label Name="DiskUses" Text="N/A" Align="Right" HorizontalExpand="True"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <LineEdit
                    Name="SearchBar"
                    PlaceHolder="{Loc 'lathe-menu-search-designs'}"
                    HorizontalExpand="True"/>
                <OptionButton
                    Name="FilterOption"
                    MinWidth="100"
                    StyleClasses="ButtonSquare"/>
            </BoxContainer>
            <BoxContainer Orientation="Vertical"
                VerticalExpand="True"
                HorizontalExpand="True">
                <PanelContainer VerticalExpand="True" HorizontalExpand="True" StyleClasses="PanelDeep">
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                        <BoxContainer
                            Name="RecipeList"
                            Orientation="Vertical"
                            HorizontalExpand="True"
                            VerticalExpand="True"
                            RectClipContent="True"/>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Margin="8 0 8 0" Text="{Loc 'lathe-menu-amount'}" />
                <LineEdit
                    Name="AmountLineEdit"
                    PlaceHolder="0"
                    Text="1"
                    SetWidth="60" />
                <Control HorizontalExpand="True"/>
                <Label Name="RecipeCount" Margin="8 0 8 0" MinWidth="90" Align="Right" />
            </BoxContainer>
        </BoxContainer>

        <!-- Col 2: Queue & Printing -->
        <BoxContainer
            Orientation="Vertical"
            VerticalExpand="True"
            HorizontalExpand="True"
            SizeFlagsStretchRatio="4"
            MinWidth="260"
            SeparationOverride="5">
            <BoxContainer
                Orientation="Horizontal"
                Align="End"
                HorizontalExpand="True">
                <Label Text="{Loc 'lathe-menu-queue-title'}" HorizontalAlignment="Left" HorizontalExpand="True" Margin="2 0 0 0"/>
                <Button
                    Name="ServerListButton"
                    Text="{Loc 'lathe-menu-server-list'}"
                    TextAlign="Center"
                    Mode="Press"/>
            </BoxContainer>
            <PanelContainer
                Name="FabricatingContainer"
                HorizontalExpand="True"
                StyleClasses="PanelDeep">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6" SeparationOverride="4">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <BoxContainer
                            Name="FabricatingDisplayContainer"
                            MinSize="28 28"
                            VerticalAlignment="Center"
                            Margin="0 0 6 0"/>
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                            <Label
                                Text="{Loc 'lathe-menu-fabricating-message'}"
                                StyleClasses="LabelSubText"
                                FontColorOverride="#A0FFA0"/>
                            <Label
                                Name="NameLabel"
                                RectClipContent="True"
                                StyleClasses="LabelKeyText"/>
                        </BoxContainer>
                        <Button
                            Name="DeleteFabricating"
                            Margin="0"
                            Text="✖"
                            SetSize="28 28"
                            VerticalAlignment="Center"
                            ToolTip="{Loc 'lathe-menu-delete-fabricating-tooltip'}"
                            StyleClasses="negative OpenLeft"/>
                    </BoxContainer>
                    <ProgressBar
                        Name="PrintingProgressBar"
                        MinValue="0"
                        MaxValue="1"
                        MinHeight="14"
                        HorizontalExpand="True"
                        Margin="0 2 0 0"/>
                    <Label
                        Name="PrintingProgressLabel"
                        HorizontalAlignment="Right"
                        StyleClasses="LabelSubText"/>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer VerticalExpand="True" HorizontalExpand="True" StyleClasses="PanelDeep">
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                    <BoxContainer
                        Name="QueueList"
                        Orientation="Vertical"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        RectClipContent="True"/>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>

        <!-- Col 3: Semi-detached Stored Materials -->
        <PanelContainer
            VerticalExpand="True"
            MinWidth="250"
            SetWidth="260"
            StyleClasses="PanelDeep"
            Margin="2 0 0 0">
            <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="6" SeparationOverride="4">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 2 0 4">
                    <Label Text="{Loc 'lathe-menu-materials-title'}" StyleClasses="LabelSubHeader" HorizontalExpand="True" HorizontalAlignment="Center"/>
                </BoxContainer>
                <ui:MaterialStorageControl Name="MaterialsList" VerticalExpand="True" HorizontalExpand="True"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>